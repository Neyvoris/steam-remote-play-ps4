set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER clang)
set(CMAKE_LINKER ld.lld)
set(SDK "$ENV{OO_PS4_TOOLCHAIN}")
if(NOT EXISTS "${SDK}/link.x")
    message(FATAL_ERROR "Set OO_PS4_TOOLCHAIN to the extracted OpenOrbis SDK")
endif()
set(CMAKE_C_FLAGS_INIT "--target=x86_64-pc-freebsd12-elf -isysroot ${SDK} -isystem ${SDK}/include -D__ORBIS__ -D__OPENORBIS__ -fPIC -funwind-tables")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m elf_x86_64 -pie --eh-frame-hdr --script ${SDK}/link.x ${SDK}/lib/crt1.o -L${SDK}/lib")
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> -o <TARGET> <LINK_FLAGS> <OBJECTS> <LINK_LIBRARIES> -lc -lkernel")
